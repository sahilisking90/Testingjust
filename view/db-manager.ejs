<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>DB Manager — OSINT Gateway</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<style>
:root{
  --bg:#030712;--surface:#0d1117;--surface2:#161b22;--surface3:#1c2128;
  --border:rgba(255,255,255,.07);--border2:rgba(255,255,255,.13);
  --text:#e6edf3;--muted:#7d8590;--muted2:#484f58;
  --green:#3fb950;--red:#f85149;--blue:#58a6ff;
  --purple:#bc8cff;--amber:#e3b341;--accent:#7c3aed;--accent2:#a855f7;--rose:#f472b6;
  --glow:rgba(124,58,237,.18);
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:'Inter',system-ui,sans-serif;background:var(--bg);color:var(--text);min-height:100vh;-webkit-font-smoothing:antialiased;}
::-webkit-scrollbar{width:5px;height:5px}::-webkit-scrollbar-track{background:var(--bg)}::-webkit-scrollbar-thumb{background:var(--surface3);border-radius:3px}
.ambient{position:fixed;inset:0;z-index:0;pointer-events:none;overflow:hidden}
.amb-blob{position:absolute;border-radius:50%;filter:blur(130px);opacity:.2}
.amb-blob:nth-child(1){width:500px;height:500px;left:-80px;top:-80px;background:radial-gradient(circle,#1d4ed8,transparent 70%);animation:float1 22s ease-in-out infinite}
.amb-blob:nth-child(2){width:400px;height:400px;right:-60px;top:250px;background:radial-gradient(circle,#7c3aed,transparent 70%);animation:float2 28s ease-in-out infinite}
@keyframes float1{0%,100%{transform:translate(0,0)}50%{transform:translate(40px,30px)}}
@keyframes float2{0%,100%{transform:translate(0,0)}50%{transform:translate(-40px,50px)}}
.layout{display:flex;min-height:100vh;position:relative;z-index:1}
.main{margin-left:240px;flex:1;padding:2rem 2rem 4rem;max-width:100%}

/* ── HEADER ── */
.page-header{display:flex;align-items:flex-start;justify-content:space-between;gap:1rem;margin-bottom:2rem;flex-wrap:wrap}
.page-title-block{}
.page-eyebrow{font-family:'JetBrains Mono',monospace;font-size:.65rem;letter-spacing:.2em;text-transform:uppercase;color:var(--blue);margin-bottom:.5rem;opacity:.85}
.page-title{font-size:clamp(1.6rem,3vw,2.2rem);font-weight:800;letter-spacing:-.04em;line-height:1.1}
.page-title .grad{background:linear-gradient(120deg,var(--text) 20%,var(--blue) 60%,var(--accent2) 90%);-webkit-background-clip:text;background-clip:text;color:transparent}
.page-sub{font-size:.85rem;color:var(--muted);margin-top:.4rem}
.header-actions{display:flex;gap:.6rem;align-items:center;flex-wrap:wrap;margin-top:.5rem}

/* ── OVERVIEW CARDS ── */
.overview-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:.85rem;margin-bottom:2rem}
.ov-card{background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:1.1rem 1.2rem;position:relative;overflow:hidden;transition:border-color .2s,box-shadow .2s}
.ov-card:hover{border-color:var(--border2);box-shadow:0 4px 20px rgba(0,0,0,.4)}
.ov-card::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;border-radius:12px 12px 0 0}
.ov-card.blue::before{background:linear-gradient(90deg,var(--blue),transparent)}
.ov-card.green::before{background:linear-gradient(90deg,var(--green),transparent)}
.ov-card.amber::before{background:linear-gradient(90deg,var(--amber),transparent)}
.ov-card.purple::before{background:linear-gradient(90deg,var(--purple),transparent)}
.ov-card.rose::before{background:linear-gradient(90deg,var(--rose),transparent)}
.ov-label{font-size:.65rem;text-transform:uppercase;letter-spacing:.1em;color:var(--muted);margin-bottom:.6rem;font-weight:600}
.ov-val{font-family:'JetBrains Mono',monospace;font-size:1.6rem;font-weight:700;line-height:1;letter-spacing:-.02em}
.ov-val.blue{color:var(--blue)}.ov-val.green{color:var(--green)}.ov-val.amber{color:var(--amber)}.ov-val.purple{color:var(--purple)}.ov-val.rose{color:var(--rose)}.ov-val.text{color:var(--text)}
.ov-sub{font-size:.68rem;color:var(--muted2);margin-top:.35rem}

/* ── DB SIZE METER ── */
.db-meter-card{background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:1.4rem 1.6rem;margin-bottom:1.5rem;position:relative;overflow:hidden}
.db-meter-card::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,var(--blue),var(--accent2),var(--rose));border-radius:14px 14px 0 0}
.db-meter-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:1.2rem;flex-wrap:wrap;gap:.5rem}
.db-meter-title{font-size:.82rem;font-weight:600;display:flex;align-items:center;gap:.5rem}
.db-path{font-family:'JetBrains Mono',monospace;font-size:.68rem;color:var(--muted);background:rgba(255,255,255,.04);border:1px solid var(--border);border-radius:6px;padding:.3rem .65rem;letter-spacing:.02em}
.db-size-display{display:flex;align-items:baseline;gap:.4rem;margin-bottom:.8rem}
.db-size-num{font-family:'JetBrains Mono',monospace;font-size:2.4rem;font-weight:800;color:var(--blue);line-height:1;letter-spacing:-.03em}
.db-size-unit{font-family:'JetBrains Mono',monospace;font-size:.9rem;color:var(--muted);font-weight:600}
.db-size-bytes{font-family:'JetBrains Mono',monospace;font-size:.72rem;color:var(--muted2);margin-left:.5rem}
/* progress bar */
.progress-outer{height:10px;background:var(--surface3);border-radius:5px;overflow:hidden;position:relative;margin-bottom:.6rem}
.progress-fill{height:100%;border-radius:5px;background:linear-gradient(90deg,var(--blue),var(--accent2));transition:width 1s cubic-bezier(.4,0,.2,1);position:relative}
.progress-fill::after{content:'';position:absolute;right:0;top:0;bottom:0;width:3px;background:rgba(255,255,255,.7);border-radius:2px;animation:pglow 1.5s ease-in-out infinite}
@keyframes pglow{0%,100%{opacity:.5}50%{opacity:1}}
.progress-labels{display:flex;justify-content:space-between;font-family:'JetBrains Mono',monospace;font-size:.62rem;color:var(--muted2)}
.db-stats-row{display:flex;gap:2rem;flex-wrap:wrap;margin-top:1rem;padding-top:1rem;border-top:1px solid var(--border)}
.db-stat-item{font-size:.78rem;color:var(--muted)}
.db-stat-item b{font-family:'JetBrains Mono',monospace;font-weight:700;color:var(--text)}

/* ── SECTION ── */
.section{margin-bottom:1.5rem}
.section-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:.85rem;flex-wrap:wrap;gap:.5rem}
.section-title{font-size:.88rem;font-weight:600;display:flex;align-items:center;gap:.5rem;color:var(--text)}
.section-title svg{flex-shrink:0;opacity:.7}
.section-badge{font-family:'JetBrains Mono',monospace;font-size:.62rem;color:var(--muted2);background:var(--surface2);border:1px solid var(--border);border-radius:4px;padding:.1rem .45rem}

/* ── ENDPOINT TABLE ── */
.ep-table-wrap{background:var(--surface);border:1px solid var(--border);border-radius:12px;overflow:hidden}
.ep-table{width:100%;border-collapse:collapse;font-size:.78rem}
.ep-table th{text-align:left;padding:.55rem .9rem;font-size:.62rem;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:.1em;border-bottom:1px solid var(--border);white-space:nowrap;background:rgba(255,255,255,.02)}
.ep-table td{padding:.65rem .9rem;border-bottom:1px solid rgba(255,255,255,.04);vertical-align:middle}
.ep-table tr:last-child td{border-bottom:none}
.ep-table tr:hover td{background:rgba(255,255,255,.025);transition:background .15s}
.ep-name-cell{font-family:'JetBrains Mono',monospace;color:var(--blue);font-size:.75rem;font-weight:600}
.ep-count{font-family:'JetBrains Mono',monospace;font-weight:700;font-size:.82rem}
.ep-bar-wrap{display:flex;align-items:center;gap:.65rem;min-width:140px}
.ep-bar{flex:1;height:6px;background:var(--surface3);border-radius:3px;overflow:hidden}
.ep-bar-fill{height:100%;border-radius:3px;background:linear-gradient(90deg,var(--accent),var(--accent2));transition:width .8s cubic-bezier(.4,0,.2,1)}
.ep-pct{font-family:'JetBrains Mono',monospace;font-size:.65rem;color:var(--muted2);white-space:nowrap;min-width:32px;text-align:right}
.ep-date{font-family:'JetBrains Mono',monospace;font-size:.65rem;color:var(--muted2)}
.btn-clear-ep{cursor:pointer;font-family:'JetBrains Mono',monospace;font-size:.58rem;letter-spacing:.1em;text-transform:uppercase;color:var(--red);background:transparent;border:1px solid rgba(248,81,73,.22);border-radius:5px;padding:.18rem .45rem;transition:background .2s,border-color .2s;white-space:nowrap}
.btn-clear-ep:hover{background:rgba(248,81,73,.1);border-color:rgba(248,81,73,.5)}

/* ── DAILY CHART ── */
.chart-card{background:var(--surface);border:1px solid var(--border);border-radius:12px;overflow:hidden;margin-bottom:1.5rem}
.chart-card-head{padding:.9rem 1.2rem;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between}
.chart-card-body{padding:1rem 1.2rem}

/* ── RECENT QUERIES ── */
.queries-wrap{background:var(--surface);border:1px solid var(--border);border-radius:12px;overflow:hidden}
.query-row{display:grid;grid-template-columns:auto 1fr auto auto auto;align-items:center;gap:.75rem;padding:.6rem 1rem;border-bottom:1px solid rgba(255,255,255,.04);font-size:.75rem}
.query-row:last-child{border-bottom:none}
.query-row:hover{background:rgba(255,255,255,.02)}
.query-num{font-family:'JetBrains Mono',monospace;font-size:.62rem;color:var(--muted2);width:24px;text-align:right;flex-shrink:0}
.query-ep{font-family:'JetBrains Mono',monospace;color:var(--blue);font-size:.72rem;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.query-val{font-family:'JetBrains Mono',monospace;font-size:.7rem;color:var(--amber);max-width:160px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.query-status{font-family:'JetBrains Mono',monospace;font-size:.68rem;font-weight:700;padding:.1rem .38rem;border-radius:4px;flex-shrink:0}
.qs-ok{color:var(--green);background:rgba(63,185,80,.1)}.qs-err{color:var(--red);background:rgba(248,81,73,.1)}
.query-time{font-family:'JetBrains Mono',monospace;font-size:.62rem;color:var(--muted2);white-space:nowrap;flex-shrink:0}
.query-lat{font-family:'JetBrains Mono',monospace;font-size:.65rem;color:var(--muted);flex-shrink:0}

/* ── SEARCH ── */
.search-bar{display:flex;align-items:center;gap:.5rem;background:var(--surface2);border:1px solid var(--border2);border-radius:9px;padding:.45rem .75rem;transition:border-color .2s,box-shadow .2s;margin-bottom:1rem}
.search-bar:focus-within{border-color:rgba(88,166,255,.4);box-shadow:0 0 0 3px rgba(88,166,255,.08)}
.search-bar input{flex:1;background:none;border:0;outline:none;color:var(--text);font-family:'Inter',sans-serif;font-size:.82rem}
.search-bar input::placeholder{color:var(--muted2)}

/* ── BUTTONS ── */
.btn{display:inline-flex;align-items:center;gap:.4rem;padding:.42rem .9rem;border-radius:8px;font-size:.78rem;font-family:'Inter',sans-serif;font-weight:600;cursor:pointer;transition:opacity .2s,transform .15s,background .2s;border:none;white-space:nowrap}
.btn:hover{opacity:.88;transform:translateY(-1px)}
.btn-primary{background:linear-gradient(135deg,var(--accent),var(--accent2));color:#fff;box-shadow:0 0 12px rgba(124,58,237,.3)}
.btn-danger{background:rgba(248,81,73,.12);color:var(--red);border:1px solid rgba(248,81,73,.3)}
.btn-danger:hover{background:rgba(248,81,73,.22)}
.btn-ghost{background:transparent;color:var(--muted);border:1px solid var(--border2)}
.btn-ghost:hover{color:var(--text);border-color:var(--border2)}
.btn-blue{background:rgba(88,166,255,.1);color:var(--blue);border:1px solid rgba(88,166,255,.25)}
.btn-blue:hover{background:rgba(88,166,255,.2)}

/* ── STATUS DIST ── */
.status-dist-grid{display:flex;flex-direction:column;gap:.55rem}
.sd-row{display:flex;align-items:center;gap:.75rem}
.sd-code{font-family:'JetBrains Mono',monospace;font-size:.72rem;font-weight:700;width:40px;flex-shrink:0}
.sd-bar{flex:1;height:7px;background:var(--surface3);border-radius:4px;overflow:hidden}
.sd-fill{height:100%;border-radius:4px;transition:width .8s cubic-bezier(.4,0,.2,1)}
.fill-2xx{background:var(--green)}.fill-4xx{background:var(--amber)}.fill-5xx{background:var(--red)}.fill-other{background:var(--muted2)}
.sd-count{font-family:'JetBrains Mono',monospace;font-size:.68rem;color:var(--muted);min-width:40px;text-align:right}

/* ── TOAST ── */
.toast{position:fixed;left:50%;bottom:1.8rem;z-index:200;transform:translate(-50%,2rem);opacity:0;pointer-events:none;transition:opacity .25s,transform .25s;padding:.55rem 1.1rem;border-radius:999px;font-size:.78rem;font-family:'JetBrains Mono',monospace;background:rgba(13,17,23,.96);border:1px solid rgba(168,85,247,.4);color:var(--accent2);backdrop-filter:blur(16px)}
.toast.show{opacity:1;transform:translate(-50%,0)}
.toast.danger{border-color:rgba(248,81,73,.5);color:var(--red)}
.toast.success{border-color:rgba(63,185,80,.5);color:var(--green)}

/* ── CONFIRM MODAL ── */
.modal-bg{position:fixed;inset:0;z-index:150;background:rgba(3,7,18,.85);backdrop-filter:blur(8px);display:flex;align-items:center;justify-content:center;opacity:0;pointer-events:none;transition:opacity .25s}
.modal-bg.show{opacity:1;pointer-events:auto}
.modal-box{background:var(--surface);border:1px solid rgba(248,81,73,.35);border-radius:16px;padding:1.75rem;width:min(420px,92vw);box-shadow:0 32px 80px rgba(0,0,0,.8)}
.modal-icon{width:44px;height:44px;border-radius:12px;background:rgba(248,81,73,.12);border:1px solid rgba(248,81,73,.3);display:grid;place-items:center;margin-bottom:1rem;font-size:1.3rem}
.modal-title{font-size:1.1rem;font-weight:700;margin-bottom:.4rem}
.modal-sub{font-size:.83rem;color:var(--muted);line-height:1.6;margin-bottom:1.4rem}
.modal-actions{display:flex;gap:.65rem;justify-content:flex-end}
.skel{background:linear-gradient(90deg,var(--surface2) 25%,var(--surface3) 50%,var(--surface2) 75%);background-size:400% 100%;animation:shimmer 1.4s ease infinite;border-radius:6px}
@keyframes shimmer{0%{background-position:100% 0}100%{background-position:-100% 0}}
@media(max-width:860px){.main{margin-left:0;padding:1.25rem 1rem 4rem}}
@media(max-width:600px){.overview-grid{grid-template-columns:1fr 1fr}.query-row{grid-template-columns:auto 1fr auto}}
</style>
</head>
<body data-page="db-manager">
<div class="ambient"><div class="amb-blob"></div><div class="amb-blob"></div></div>
<div class="layout">
<div class="main">

<!-- PAGE HEADER -->
<div class="page-header">
  <div class="page-title-block">
    <div class="page-eyebrow">◈ Database Manager</div>
    <h1 class="page-title"><span class="grad">DB Manager</span></h1>
    <p class="page-sub">Full visibility into your SQLite database — sizes, records, queries, cleanup.</p>
  </div>
  <div class="header-actions">
    <button class="btn btn-blue" id="btn-refresh" type="button">
      <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 8A7 7 0 0 1 13.5 4M15 8A7 7 0 0 1 2.5 12"/><path d="M12 2l1.5 2.5-2.5.5M4 13.5L2.5 11l2.5-.5"/></svg>
      Refresh
    </button>
    <button class="btn btn-blue" id="btn-export" type="button">
      <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 1v10M4 7l4 4 4-4M2 14h12"/></svg>
      Export CSV
    </button>
    <button class="btn btn-danger" id="btn-clear-all" type="button">
      <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 4h12M5 4V2h6v2M6 7v5M10 7v5M3 4l1 10h8l1-10"/></svg>
      Clear All
    </button>
  </div>
</div>

<!-- OVERVIEW CARDS -->
<div class="overview-grid" id="ov-grid">
  <div class="ov-card blue"><div class="ov-label">Total Records</div><div class="ov-val blue skel" id="ov-total" style="height:38px;width:80px;border-radius:4px"></div><div class="ov-sub" id="ov-total-sub">loading…</div></div>
  <div class="ov-card green"><div class="ov-label">DB Size</div><div class="ov-val green skel" id="ov-size" style="height:38px;width:100px;border-radius:4px"></div><div class="ov-sub" id="ov-size-sub">loading…</div></div>
  <div class="ov-card amber"><div class="ov-label">Unique Inputs</div><div class="ov-val amber skel" id="ov-inputs" style="height:38px;width:70px;border-radius:4px"></div><div class="ov-sub">distinct query values</div></div>
  <div class="ov-card purple"><div class="ov-label">Unique IPs</div><div class="ov-val purple skel" id="ov-ips" style="height:38px;width:70px;border-radius:4px"></div><div class="ov-sub">distinct callers</div></div>
  <div class="ov-card rose"><div class="ov-label">Endpoints Tracked</div><div class="ov-val rose skel" id="ov-eps" style="height:38px;width:50px;border-radius:4px"></div><div class="ov-sub">with query history</div></div>
</div>

<!-- DB SIZE METER -->
<div class="db-meter-card" id="meter-card">
  <div class="db-meter-top">
    <div class="db-meter-title">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><ellipse cx="8" cy="4" rx="6" ry="2"/><path d="M2 4v4c0 1.1 2.7 2 6 2s6-.9 6-2V4"/><path d="M2 8v4c0 1.1 2.7 2 6 2s6-.9 6-2V8"/></svg>
      SQLite Database
    </div>
    <span class="db-path" id="db-path">/tmp/osint.db</span>
  </div>
  <div class="db-size-display">
    <span class="db-size-num" id="db-size-num">—</span>
    <span class="db-size-unit" id="db-size-unit">KB</span>
    <span class="db-size-bytes" id="db-size-bytes"></span>
  </div>
  <div class="progress-outer">
    <div class="progress-fill" id="db-progress" style="width:0%"></div>
  </div>
  <div class="progress-labels">
    <span>0 KB</span>
    <span id="db-progress-label">Max ~100 MB (Render free tier)</span>
    <span>100 MB</span>
  </div>
  <div class="db-stats-row">
    <div class="db-stat-item">Path <b id="db-stat-path">—</b></div>
    <div class="db-stat-item">Rows <b id="db-stat-rows">—</b></div>
    <div class="db-stat-item">Endpoints <b id="db-stat-eps">—</b></div>
    <div class="db-stat-item">Exported <b id="db-stat-ts">—</b></div>
  </div>
</div>

<!-- DAILY CHART -->
<div class="chart-card">
  <div class="chart-card-head">
    <div class="section-title">
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M1 12l4-5 3 3 4-6 3 4"/></svg>
      Daily Query Volume (Last 30 Days)
    </div>
    <span class="section-badge" id="daily-total">—</span>
  </div>
  <div class="chart-card-body">
    <div style="height:180px;position:relative"><canvas id="chart-daily"></canvas></div>
  </div>
</div>

<!-- ENDPOINT BREAKDOWN -->
<div class="section">
  <div class="section-head">
    <div class="section-title">
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="1" y="10" width="3" height="5" rx=".5"/><rect x="6" y="6" width="3" height="9" rx=".5"/><rect x="11" y="2" width="3" height="13" rx=".5"/></svg>
      Endpoint Breakdown
    </div>
    <span class="section-badge" id="ep-count-badge">— endpoints</span>
  </div>
  <div class="ep-table-wrap">
    <div style="overflow-x:auto">
      <table class="ep-table">
        <thead><tr>
          <th>Endpoint</th><th>Records</th><th>Success</th><th>Errors</th>
          <th>Avg ms</th><th>Share</th><th>First Seen</th><th>Last Seen</th><th>Action</th>
        </tr></thead>
        <tbody id="ep-tbody"><tr><td colspan="9" style="text-align:center;padding:2rem;color:var(--muted)">Loading…</td></tr></tbody>
      </table>
    </div>
  </div>
</div>

<!-- STATUS DISTRIBUTION + RECENT QUERIES GRID -->
<div style="display:grid;grid-template-columns:1fr 2fr;gap:1rem;margin-bottom:1.5rem">
  <div style="background:var(--surface);border:1px solid var(--border);border-radius:12px;overflow:hidden">
    <div class="chart-card-head"><div class="section-title"><svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="8" cy="8" r="6"/><path d="M8 5v4l2 2"/></svg>Status Distribution</div></div>
    <div style="padding:1rem 1.2rem"><div class="status-dist-grid" id="status-dist"><div style="text-align:center;padding:1.5rem;color:var(--muted);font-size:.8rem">Loading…</div></div></div>
  </div>
  <div style="background:var(--surface);border:1px solid var(--border);border-radius:12px;overflow:hidden">
    <div class="chart-card-head"><div class="section-title">Queries Chart</div></div>
    <div style="padding:1rem;height:180px;position:relative"><canvas id="chart-pie"></canvas></div>
  </div>
</div>

<!-- RECENT QUERIES -->
<div class="section">
  <div class="section-head">
    <div class="section-title">
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M1 2h14v2H1zM1 6h14v2H1zM1 10h14v2H1z"/></svg>
      Recent Queries <span class="section-badge" id="recent-count-badge" style="margin-left:.4rem">0</span>
    </div>
    <div style="display:flex;gap:.5rem;align-items:center">
      <div class="search-bar" style="margin-bottom:0;width:220px">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <input type="search" placeholder="Filter by endpoint or value…" id="query-search">
      </div>
    </div>
  </div>
  <div class="queries-wrap">
    <div style="display:grid;grid-template-columns:auto 1fr auto auto auto;gap:.75rem;padding:.5rem 1rem;border-bottom:1px solid var(--border);background:rgba(255,255,255,.02)">
      <span style="font-size:.6rem;text-transform:uppercase;letter-spacing:.1em;color:var(--muted2);font-weight:600">#</span>
      <span style="font-size:.6rem;text-transform:uppercase;letter-spacing:.1em;color:var(--muted2);font-weight:600">Endpoint / Value</span>
      <span style="font-size:.6rem;text-transform:uppercase;letter-spacing:.1em;color:var(--muted2);font-weight:600">Status</span>
      <span style="font-size:.6rem;text-transform:uppercase;letter-spacing:.1em;color:var(--muted2);font-weight:600">Latency</span>
      <span style="font-size:.6rem;text-transform:uppercase;letter-spacing:.1em;color:var(--muted2);font-weight:600">Time</span>
    </div>
    <div id="queries-list"><div style="text-align:center;padding:2.5rem;color:var(--muted);font-size:.82rem">Loading…</div></div>
  </div>
</div>

</div>
</div>

<!-- TOAST -->
<div class="toast" id="toast">Done</div>

<!-- CONFIRM MODAL -->
<div class="modal-bg" id="confirm-modal">
  <div class="modal-box">
    <div class="modal-icon">🗑</div>
    <div class="modal-title" id="modal-title">Clear all queries?</div>
    <div class="modal-sub" id="modal-sub">This will permanently delete all query records from the database. This action cannot be undone.</div>
    <div class="modal-actions">
      <button class="btn btn-ghost" id="modal-cancel">Cancel</button>
      <button class="btn btn-danger" id="modal-confirm">Delete</button>
    </div>
  </div>
</div>

<script src="/nav.js"></script>
<script>
(function(){
'use strict';

var ADMIN_KEY = '';  // will be prompted once if needed
var _data = null;
var _allQueries = [];
var dailyChart = null, pieChart2 = null;

// ── toast ──
var toastEl = document.getElementById('toast');
var _tt;
function toast(msg, type){
  toastEl.textContent = msg;
  toastEl.className = 'toast' + (type ? ' '+type : '');
  toastEl.classList.add('show');
  clearTimeout(_tt);
  _tt = setTimeout(function(){ toastEl.classList.remove('show'); }, 2200);
}

// ── format helpers ──
function fmt(n){if(n==null)return'—';if(n>=1e6)return(n/1e6).toFixed(1)+'M';if(n>=1e3)return(n/1e3).toFixed(1)+'K';return String(n);}
function fmtDate(s){if(!s)return'—';try{return new Date(s).toLocaleDateString('en-US',{month:'short',day:'numeric'});}catch(e){return s;}}
function fmtDateTime(s){if(!s)return'—';try{return new Date(s).toLocaleString('en-US',{month:'short',day:'numeric',hour:'2-digit',minute:'2-digit',hour12:false});}catch(e){return s;}}
function scFillCls(code){var c=parseInt(code,10);if(c>=200&&c<300)return'fill-2xx';if(c>=400&&c<500)return'fill-4xx';if(c>=500)return'fill-5xx';return'fill-other';}
function scTextCls(code){var c=parseInt(code,10);if(c>=200&&c<300)return'color:var(--green)';if(c>=400&&c<500)return'color:var(--amber)';if(c>=500)return'color:var(--red)';return'color:var(--muted)';}

// ── init charts ──
Chart.defaults.color='#7d8590';Chart.defaults.font.family="'JetBrains Mono',monospace";Chart.defaults.font.size=10;

function initDailyChart(data){
  var ctx = document.getElementById('chart-daily').getContext('2d');
  var labels = data.map(function(d){return fmtDate(d.date);}).reverse();
  var counts = data.map(function(d){return d.count;}).reverse();
  if(dailyChart) dailyChart.destroy();
  dailyChart = new Chart(ctx, {
    type:'bar',
    data:{
      labels:labels,
      datasets:[{
        label:'Queries',data:counts,
        backgroundColor:'rgba(88,166,255,.5)',borderColor:'#58a6ff',
        borderWidth:1,borderRadius:3
      }]
    },
    options:{
      responsive:true,maintainAspectRatio:false,
      plugins:{legend:{display:false},tooltip:{backgroundColor:'#0d1117',borderColor:'rgba(255,255,255,.12)',borderWidth:1}},
      scales:{
        x:{grid:{color:'#30363d',drawTicks:false},border:{display:false},ticks:{maxRotation:0,maxTicksLimit:15}},
        y:{beginAtZero:true,grid:{color:'#30363d',drawTicks:false},border:{display:false},ticks:{precision:0}}
      }
    }
  });
}

function initPieChart2(success, errors){
  var ctx = document.getElementById('chart-pie').getContext('2d');
  if(pieChart2) pieChart2.destroy();
  pieChart2 = new Chart(ctx, {
    type:'doughnut',
    data:{
      labels:['Success','Error'],
      datasets:[{data:[success,errors],backgroundColor:['#3fb950','#f85149'],borderColor:'#0d1117',borderWidth:3,hoverOffset:4}]
    },
    options:{
      responsive:true,maintainAspectRatio:false,cutout:'65%',
      plugins:{legend:{display:true,position:'right',labels:{boxWidth:8,boxHeight:8,padding:14,pointStyle:'circle',usePointStyle:true}},tooltip:{backgroundColor:'#0d1117',borderColor:'rgba(255,255,255,.12)',borderWidth:1}}
    }
  });
}

// ── render ──
function render(d){
  _data = d;

  // overview cards
  function setOv(id, val, clr){
    var el = document.getElementById(id);
    el.className = 'ov-val '+(clr||'text');
    el.textContent = val;
  }
  setOv('ov-total', fmt(d.totalQueries), 'blue');
  document.getElementById('ov-total-sub').textContent = d.totalQueries + ' total rows';
  var sizeMB = parseFloat(d.dbSizeMB);
  var sizeDisplay = sizeMB >= 0.1 ? sizeMB.toFixed(2)+' MB' : d.dbSizeKB+' KB';
  setOv('ov-size', sizeMB >= 0.1 ? parseFloat(d.dbSizeMB).toFixed(2) : d.dbSizeKB, 'green');
  document.getElementById('ov-size-sub').textContent = sizeMB >= 0.1 ? 'MB on disk' : 'KB on disk';
  setOv('ov-inputs', fmt(d.uniqueInputs), 'amber');
  setOv('ov-ips', fmt(d.uniqueIps), 'purple');
  setOv('ov-eps', fmt(d.endpoints ? d.endpoints.length : 0), 'rose');

  // db size meter
  document.getElementById('db-path').textContent = d.dbPath || '/tmp/osint.db';
  document.getElementById('db-stat-path').textContent = d.dbPath || '—';
  document.getElementById('db-stat-rows').textContent = fmt(d.totalQueries);
  document.getElementById('db-stat-eps').textContent = d.endpoints ? d.endpoints.length : '—';
  document.getElementById('db-stat-ts').textContent = d.exportedAt ? new Date(d.exportedAt).toLocaleTimeString() : '—';
  var sizeKB = parseFloat(d.dbSizeKB);
  var sizeMBVal = parseFloat(d.dbSizeMB);
  var maxMB = 100;
  var pct = Math.min(100, (sizeMBVal / maxMB) * 100);
  if(pct < 0.1 && d.dbSizeBytes > 0) pct = 0.3; // at least visible
  document.getElementById('db-progress').style.width = pct + '%';
  if(sizeMBVal >= 0.1){
    document.getElementById('db-size-num').textContent = sizeMBVal.toFixed(2);
    document.getElementById('db-size-unit').textContent = 'MB';
  } else {
    document.getElementById('db-size-num').textContent = parseFloat(d.dbSizeKB).toFixed(1);
    document.getElementById('db-size-unit').textContent = 'KB';
  }
  document.getElementById('db-size-bytes').textContent = '('+d.dbSizeBytes+' bytes)';

  // daily chart
  if(d.dailyStats && d.dailyStats.length){
    initDailyChart(d.dailyStats);
    document.getElementById('daily-total').textContent = d.dailyStats.reduce(function(s,r){return s+r.count;},0)+' total';
  }

  // endpoint table
  var tbody = document.getElementById('ep-tbody');
  document.getElementById('ep-count-badge').textContent = (d.endpoints ? d.endpoints.length : 0)+' endpoints';
  if(!d.endpoints || !d.endpoints.length){
    tbody.innerHTML = '<tr><td colspan="9" style="text-align:center;padding:2.5rem;color:var(--muted)">No records yet</td></tr>';
  } else {
    var maxCount = d.endpoints[0].count;
    var totalSuccess = 0, totalError = 0;
    tbody.innerHTML = d.endpoints.map(function(ep){
      var pct = maxCount > 0 ? Math.round((ep.count/maxCount)*100) : 0;
      var share = d.totalQueries > 0 ? ((ep.count/d.totalQueries)*100).toFixed(1) : '0.0';
      totalSuccess += ep.success||0;
      totalError += ep.errors||0;
      return '<tr>'+
        '<td><span class="ep-name-cell">/api/'+ep.endpoint+'</span></td>'+
        '<td><span class="ep-count" style="color:var(--blue)">'+fmt(ep.count)+'</span></td>'+
        '<td><span class="ep-count" style="color:var(--green)">'+fmt(ep.success)+'</span></td>'+
        '<td><span class="ep-count" style="color:var(--red)">'+fmt(ep.errors)+'</span></td>'+
        '<td><span class="ep-count" style="color:var(--amber)">'+(ep.avg_time?parseFloat(ep.avg_time).toFixed(0)+'ms':'—')+'</span></td>'+
        '<td><div class="ep-bar-wrap"><div class="ep-bar"><div class="ep-bar-fill" style="width:'+pct+'%"></div></div><span class="ep-pct">'+share+'%</span></div></td>'+
        '<td class="ep-date">'+fmtDate(ep.first_seen)+'</td>'+
        '<td class="ep-date">'+fmtDate(ep.last_seen)+'</td>'+
        '<td><button class="btn-clear-ep" data-ep="'+ep.endpoint+'" onclick="clearEndpoint(this)">Clear</button></td>'+
      '</tr>';
    }).join('');
    // pie chart 2
    initPieChart2(totalSuccess, totalError);
  }

  // status dist
  var sdEl = document.getElementById('status-dist');
  if(!d.statusDistribution || !d.statusDistribution.length){
    sdEl.innerHTML = '<div style="text-align:center;padding:1.5rem;color:var(--muted);font-size:.8rem">No data</div>';
  } else {
    var maxSd = d.statusDistribution[0].count;
    sdEl.innerHTML = d.statusDistribution.map(function(s){
      var pct = maxSd > 0 ? Math.round((s.count/maxSd)*100) : 0;
      var fcls = scFillCls(s.response_status);
      var tcls = scTextCls(s.response_status);
      return '<div class="sd-row">'+
        '<span class="sd-code" style="'+tcls+'">'+s.response_status+'</span>'+
        '<div class="sd-bar"><div class="sd-fill '+fcls+'" style="width:'+pct+'%"></div></div>'+
        '<span class="sd-count">'+fmt(s.count)+'</span>'+
      '</div>';
    }).join('');
  }

  // recent queries
  _allQueries = d.recentQueries || [];
  renderQueries(_allQueries);
}

function renderQueries(list){
  document.getElementById('recent-count-badge').textContent = list.length;
  var el = document.getElementById('queries-list');
  if(!list.length){
    el.innerHTML = '<div style="text-align:center;padding:2.5rem;color:var(--muted);font-size:.82rem">No queries found</div>';
    return;
  }
  el.innerHTML = list.map(function(q, i){
    var ok = q.response_status && q.response_status < 400;
    var statusCls = ok ? 'qs-ok' : 'qs-err';
    return '<div class="query-row">'+
      '<span class="query-num">'+(i+1)+'</span>'+
      '<div style="min-width:0">'+
        '<div class="query-ep">/api/'+q.endpoint+'</div>'+
        '<div class="query-val">'+(q.input_value||'—')+'</div>'+
      '</div>'+
      '<span class="query-status '+statusCls+'">'+(q.response_status||'ERR')+'</span>'+
      '<span class="query-lat">'+(q.execution_time?q.execution_time+'ms':'—')+'</span>'+
      '<span class="query-time">'+fmtDateTime(q.created_at)+'</span>'+
    '</div>';
  }).join('');
}

// ── search ──
document.getElementById('query-search').addEventListener('input', function(){
  var q = this.value.toLowerCase().trim();
  if(!q){ renderQueries(_allQueries); return; }
  renderQueries(_allQueries.filter(function(r){
    return (r.endpoint||'').toLowerCase().includes(q) || (r.input_value||'').toLowerCase().includes(q);
  }));
});

// ── fetch data ──
function fetchData(){
  fetch('/db/stats').then(function(r){return r.json();}).then(function(d){
    render(d);
    toast('Refreshed', 'success');
  }).catch(function(e){
    toast('Fetch failed: '+e.message, 'danger');
  });
}

// ── clear endpoint ──
window.clearEndpoint = function(btn){
  var ep = btn.dataset.ep;
  showConfirm(
    'Clear /api/'+ep+' ?',
    'This will delete all query records for this endpoint. Cannot be undone.',
    function(){
      var key = getKey();
      fetch('/db/clear?endpoint='+encodeURIComponent(ep)+'&key='+encodeURIComponent(key), {method:'DELETE'})
        .then(function(r){return r.json();})
        .then(function(d){
          if(d.success){ toast('Cleared '+ep+' ('+d.deleted+' rows)', 'success'); fetchData(); }
          else { toast('Failed: '+(d.error||'?'), 'danger'); }
        }).catch(function(e){ toast('Error: '+e.message, 'danger'); });
    }
  );
};

// ── clear all ──
document.getElementById('btn-clear-all').addEventListener('click', function(){
  showConfirm(
    'Clear ALL queries?',
    'This permanently deletes every query record and resets analytics. This CANNOT be undone.',
    function(){
      var key = getKey();
      fetch('/db/clear?key='+encodeURIComponent(key), {method:'DELETE'})
        .then(function(r){return r.json();})
        .then(function(d){
          if(d.success){ toast('All cleared!', 'success'); fetchData(); }
          else { toast('Failed: '+(d.error||'Unauthorized?'), 'danger'); }
        }).catch(function(e){ toast('Error: '+e.message, 'danger'); });
    }
  );
});

// ── export CSV ──
document.getElementById('btn-export').addEventListener('click', function(){
  if(!_data) return;
  var lines = ['# DB Stats Export\n# Exported: '+new Date().toISOString()+'\n'];
  lines.push('# Overview\nMetric,Value');
  lines.push('total_queries,'+_data.totalQueries);
  lines.push('db_size_bytes,'+_data.dbSizeBytes);
  lines.push('db_size_kb,'+_data.dbSizeKB);
  lines.push('unique_inputs,'+_data.uniqueInputs);
  lines.push('unique_ips,'+_data.uniqueIps);
  if(_data.endpoints && _data.endpoints.length){
    lines.push('\n# Endpoint Breakdown\nEndpoint,Records,Success,Errors,Avg_ms,First_Seen,Last_Seen');
    _data.endpoints.forEach(function(ep){
      lines.push('/api/'+ep.endpoint+','+ep.count+','+(ep.success||0)+','+(ep.errors||0)+','+(ep.avg_time?parseFloat(ep.avg_time).toFixed(0):'')+','+ep.first_seen+','+ep.last_seen);
    });
  }
  if(_data.recentQueries && _data.recentQueries.length){
    lines.push('\n# Recent Queries\nEndpoint,Input_Value,Status,Latency_ms,Time');
    _data.recentQueries.forEach(function(q){
      var v = String(q.input_value||'').replace(/,/g,' ');
      lines.push('/api/'+q.endpoint+','+v+','+q.response_status+','+q.execution_time+','+q.created_at);
    });
  }
  var blob = new Blob([lines.join('\n')], {type:'text/csv'});
  var a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = 'db-export-'+new Date().toISOString().slice(0,10)+'.csv';
  document.body.appendChild(a); a.click(); document.body.removeChild(a);
  toast('CSV downloaded', 'success');
});

// ── refresh button ──
document.getElementById('btn-refresh').addEventListener('click', fetchData);

// ── confirm modal ──
var _confirmCb = null;
function showConfirm(title, sub, cb){
  document.getElementById('modal-title').textContent = title;
  document.getElementById('modal-sub').textContent = sub;
  _confirmCb = cb;
  document.getElementById('confirm-modal').classList.add('show');
}
document.getElementById('modal-cancel').addEventListener('click', function(){
  document.getElementById('confirm-modal').classList.remove('show');
  _confirmCb = null;
});
document.getElementById('modal-confirm').addEventListener('click', function(){
  document.getElementById('confirm-modal').classList.remove('show');
  if(_confirmCb){ _confirmCb(); _confirmCb = null; }
});

// ── admin key ──
function getKey(){
  if(!ADMIN_KEY){
    ADMIN_KEY = prompt('Admin key:') || '';
  }
  return ADMIN_KEY;
}

// ── boot ──
fetchData();

})();
</script>
</body>
</html>
